{
  "name": "keylit",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Drop a guitar chord sheet, see it on a piano — lit keys, voice leading, a chord-move lab, and a capo advisor.",
  "author": "Tyler Eveland <j.tyler.eveland@gmail.com>",
  "main": "electron/main.cjs",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools": "node --test tools/*.test.mjs",
    "proxy": "node server.mjs",
    "electron": "electron .",
    "electron:dev": "vite",
    "pack": "vite build && electron-builder --dir",
    "dist:win": "vite build && electron-builder --win",
    "check:publish": "node tools/check_publish.mjs",
    "build:deploy": "vite build && node tools/check_publish.mjs --strip"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "//": "@anthropic-ai/sdk is server-only (api/analyze.js + server.mjs); the browser bundle never imports it.",
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.69.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.tylereveland.keylit",
    "productName": "Keylit",
    "copyright": "Copyright © 2026 Tyler Eveland",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keylit",
      "differentialPackage": false
    },
    "publish": null
  }
}
