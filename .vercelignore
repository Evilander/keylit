# The scraped tab corpus is personal-use only — never publish it.
public/corpus
# `vite build` copies public/ wholesale, so dist/ carries a second copy of the
# corpus (and the licensed fonts below). Vercel's Git builds never upload dist
# — they build it on the server — but a `vercel` CLI deploy from this directory
# would ship whatever is sitting here.
dist
# Berkeley Mono is licensed per-seat. Serving it from a public URL is
# redistribution; the app falls back to a system monospace without it.
public/fonts/BerkeleyMono-*.woff2
# Local/desktop-only surfaces.
release
electron
tools
server.mjs
# Working material — planning, notes, agent config. Gitignored too, but a CLI
# deploy uploads the working directory, not the git tree.
docs
notes
.superpowers
.playwright-mcp
